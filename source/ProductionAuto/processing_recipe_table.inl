static constexpr size_t kProcessingRecipeMachineIndexCount =
    sizeof(kProcessingRecipeMachineIndex) / sizeof(kProcessingRecipeMachineIndex[0]);

// Lookup recipes by machine type.  Returns a pointer to the index entry
// or nullptr if the machine type has no recipes.
static const ProcessingRecipeMachineIndex*
ProductionRecipeMachineIndexLookup(u64 machineId) {
    for (size_t i = 0; i < kProcessingRecipeMachineIndexCount; ++i) {
        if (kProcessingRecipeMachineIndex[i].machineId == machineId)
            return &kProcessingRecipeMachineIndex[i];
    }
    return nullptr;
}

